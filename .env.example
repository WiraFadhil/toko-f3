MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
SECRET_KEY=ganti-dengan-kunci-rahasia-anda
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== AI Customer Service (semua gratis) =====
# Dapatkan API key (semua free, tanpa kartu kredit):
#   Groq     -> https://console.groq.com           (pakai akun Google)
#   Cerebras -> https://cloud.cerebras.ai          (pakai akun Google)
#   Mistral  -> https://console.mistral.ai         (pakai email, plan Experiment)
#   Gemini   -> https://aistudio.google.com/apikey (pakai akun Google)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Urutan provider dicoba (default: groq,cerebras,mistral,gemini)
# AI_PROVIDER_ORDER=groq,cerebras,mistral,gemini
# Timeout tiap panggilan LLM dalam detik (default: 20)
# AI_REQUEST_TIMEOUT=20
# Maksimal provider dicoba per permintaan (default: 2)
# AI_MAX_PROVIDERS=2
